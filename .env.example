# InstaDaily Environment Variables
# Copy this file to .env.local and replace with your project's Supabase API credentials

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Project Anon / Public Key (Find in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
