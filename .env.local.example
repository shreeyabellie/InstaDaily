# Copy this file to .env.local (untracked — see .gitignore) and fill in
# your Supabase project's values: Supabase Dashboard -> Project Settings -> API.
#
# Read by:
#   - apps/web/middleware.ts (edge-side session check)
#   - apps/web/context/AuthContext.tsx (browser-side Supabase client)
#
# Both are NEXT_PUBLIC_* because the browser client needs them client-side;
# the anon key is safe to expose — it's constrained by your Row Level
# Security policies, not a secret credential.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
